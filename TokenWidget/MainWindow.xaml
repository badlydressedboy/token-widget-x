<Window x:Class="TokenWidget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Token Window" Icon="Assets/token-widget.ico" Width="670" Height="475" MinWidth="560" MinHeight="430" Background="#101722" Foreground="#EDF3FC" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <CheckBox x:Name="Pin" DockPanel.Dock="Right" Content="Always on top" Foreground="#A5B4C8" VerticalAlignment="Center" Checked="PinChanged" Unchecked="PinChanged"/>
   <StackPanel><TextBlock Text="TOKEN WINDOW" FontSize="13" FontWeight="Bold" Foreground="#7DE1CB"/><TextBlock x:Name="Renewal" Text="Looking for weekly usage…" Margin="0,7,0,0" Foreground="#A5B4C8"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock x:Name="Remaining" Text="—" FontSize="34" FontWeight="SemiBold"/><TextBlock x:Name="Used" Text="Weekly allowance remaining" Foreground="#A5B4C8"/></StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="Prediction" Text="Waiting for readings" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="Rate" Text="Estimated burn" Foreground="#A5B4C8" Margin="0,7,0,0"/></StackPanel>
  </Grid>
  <Canvas x:Name="Chart" Grid.Row="2" ClipToBounds="True" SizeChanged="ChartSizeChanged" MinHeight="140"/>
  <DockPanel Grid.Row="3" Margin="0,14,0,12">
   <ComboBox x:Name="Horizon" DockPanel.Dock="Right" Width="150" SelectedIndex="0" SelectionChanged="HorizonChanged"><ComboBoxItem Content="Auto (6h / week)"/><ComboBoxItem Content="Last 6 hours"/><ComboBoxItem Content="Last 24 hours"/><ComboBoxItem Content="Whole week"/></ComboBox>
   <TextBlock VerticalAlignment="Center"><Run Text="━ Actual remaining" Foreground="#7DE1CB"/><Run Text="    ┄ Forecast" Foreground="#FDBB74"/></TextBlock>
  </DockPanel>
  <TextBlock x:Name="Status" Grid.Row="4" Foreground="#8798AF" FontSize="11" TextWrapping="Wrap" Text="Reading local Codex usage snapshots. No credentials needed."/>
 </Grid>
</Window>
